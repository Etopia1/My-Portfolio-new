# ==============================================================================
# Portfolio Environment Configuration
# Copy this file to .env.local and fill in your credentials for production.
# ==============================================================================

# Public Site URL (used for Open Graph, canonical links, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://andrew-etopia.vercel.app

# Optional: Google Analytics / Vercel Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Supabase Configuration (for persisting Contact Form submissions)
# Create a table named `contact_messages` with columns:
#   id (uuid, default gen_random_uuid(), primary key)
#   name (text, not null)
#   email (text, not null)
#   subject (text, not null)
#   service (text)
#   message (text, not null)
#   created_at (timestamptz, default now())
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
